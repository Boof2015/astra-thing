{
  "name": "astra-thing-manager",
  "version": "0.3.0",
  "private": true,
  "description": "Install and maintain Astra Thing",
  "license": "GPL-3.0-only",
  "author": "Boof2015",
  "homepage": "https://github.com/Boof2015/astra-thing",
  "main": "main/index.cjs",
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "predev": "npm run build:worker",
    "dev": "node scripts/dev.cjs",
    "preview": "node scripts/preview.cjs",
    "test": "node --test test/*.test.cjs",
    "build:worker": "node scripts/build-worker.cjs",
    "build": "node scripts/build.cjs",
    "build:mac": "node scripts/build.cjs mac",
    "build:windows": "node scripts/build.cjs win",
    "build:linux": "node scripts/build.cjs linux",
    "dist": "node scripts/build.cjs"
  },
  "dependencies": {
    "bonjour-service": "1.4.0"
  },
  "devDependencies": {
    "electron": "42.11.3",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.boof2015.astrathingmanager",
    "productName": "Astra Thing Manager",
    "asar": true,
    "afterPack": "scripts/mac-identity.cjs",
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json",
      "LICENSE"
    ],
    "extraResources": [
      {
        "from": "resources/worker",
        "to": "worker"
      },
      {
        "from": "../release/trusted-keys.json",
        "to": "trusted-keys.json"
      },
      {
        "from": "../LICENSES",
        "to": "licenses"
      },
      {
        "from": "../docs/manager-platforms.md",
        "to": "Platform setup.md"
      },
      {
        "from": "node_modules/electron/dist/LICENSE",
        "to": "licenses/Electron-LICENSE.txt"
      },
      {
        "from": "node_modules/electron/dist/LICENSES.chromium.html",
        "to": "licenses/LICENSES.chromium.html"
      }
    ],
    "mac": {
      "identity": "-",
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Connect to your Astra Thing through its USB network link to install updates and manage the device.",
        "NSBonjourServices": ["_astra-thing._tcp"]
      },
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "maintainer": "Boof2015",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  }
}
